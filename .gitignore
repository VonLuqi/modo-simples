_ref-prototipo-senac/

# Variáveis de ambiente (Segurança: nunca enviar senhas)
.env

# Saída do deploy Vercel (gerada por npm run build)
public/

# Playwright (e2e)
test-results/
playwright-report/

# Artefatos FUSE/NTFS (arquivo aberto e apagado) — nunca versionar
.fuse_hidden*

# Grafo local (graphify)
graphify-out/
